{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "api/**/*.ts",
    "src/data/topics.ts",
    "src/data/problems.ts",
    "src/data/aptitude.ts",
    "src/data/aptitude-expanded.ts",
    "src/data/salaarTopics.ts",
    "src/lib/streakUtils.ts"
  ]
}
